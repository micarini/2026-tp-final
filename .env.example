# Copiá este archivo como .env.local y completá los valores.
# .env.local está en .gitignore: nunca se sube al repo.

# --- Firebase, configuración web (pública) ---
# Firebase Console > Configuración del proyecto > Tus apps > App web.
# Va con NEXT_PUBLIC_ porque el navegador la necesita para el login.
# No es secreta: la seguridad la dan las reglas y la validación en el servidor.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SECRETO, solo servidor) ---
# Firebase Console > Configuración del proyecto > Cuentas de servicio >
# Generar nueva clave privada. Copiá estos tres campos del JSON.
# La clave privada va entre comillas, con los \n tal cual vienen.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
